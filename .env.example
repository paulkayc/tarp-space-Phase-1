APP_ENV=development
APP_PORT=8000
DATABASE_URL=postgresql://tarpspace:tarpspace@localhost:5432/tarpspace
DEV_AUTH_TOKEN=dev-token-local
ADMIN_API_KEY=admin-local

# ── Cloud auth — Clerk ────────────────────────────────────────────────────────
# Leave blank for local dev. Populate when deploying to cloud.
# NOTE: ARCHITECTURE.md references Supabase; CONTRACTS.md references Clerk.
# Resolve which provider to use before cloud deployment, then remove the unused block.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── Cloud auth — Supabase (alternative to Clerk) ──────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1000

# ── Matching ──────────────────────────────────────────────────────────────────
ESCALATION_THRESHOLD_PCT=0.15
MATCH_TOP_N=5
MATCH_RADIUS_DEFAULT_M=8046
COMPLETENESS_THRESHOLD=0.7
ONBOARDING_COMPLETENESS_THRESHOLD=0.7

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LLM_COST_ALERT_THRESHOLD_USD=0.05
